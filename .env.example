# --- LM Studio (local LLM, required) ---
# Default: http://localhost:1234/v1 (host) or http://host.docker.internal:1234/v1 (Docker)
LM_STUDIO_URL=http://localhost:1234/v1

# --- LiteLLM proxy (optional, for cloud models) ---
# If using a LiteLLM proxy, set these. Otherwise leave empty to use LM Studio only.
# LITELLM_API_BASE=https://your-litellm-proxy.example.com
# LITELLM_API_KEY=your-key-here
# LITELLM_MODEL=openai/mistral/magistral-small-latest
